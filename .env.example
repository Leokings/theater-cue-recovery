# Direct-mode and GLSim verification require no repository secrets.
# Never commit real keys, mnemonics, wallet files, or provider credentials.

# External release proof: both distinct accounts must hold GEN on the selected network.
THEATER_MANAGER_PRIVATE_KEY=
THEATER_REPORTER_PRIVATE_KEY=

# Commit-bound deploy/001_deploy_and_smoke.py settings.
THEATER_SOURCE_COMMIT=
THEATER_DEPLOY_NETWORK=studionet
THEATER_DEPLOY_OUTPUT=deployments/studionet-v2-smoke.local.json

# Optional reproducible GLSim-only consensus fixture (never accepted on external networks).
THEATER_LOCAL_MOCK_CONSENSUS=0

# Resume only a previously verified checkpoint.
THEATER_RESUME=0
THEATER_RESUME_SUBMIT=0

# Opt in only if Bradbury deployment gas estimation is the confirmed blocker.
THEATER_BRADBURY_DEPLOY_GAS_OVERRIDE=0
THEATER_BRADBURY_DEPLOY_GAS_LIMIT=60000000
